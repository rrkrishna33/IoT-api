# Copy to .env and fill in. Never commit .env.
PORT=4000
HOST=127.0.0.1
DATABASE_URL=postgres://iot_user:CHANGE_ME@127.0.0.1:5432/iot
# Long random string; used for /v1/admin/* (create customers, devices, keys).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_KEY=CHANGE_ME
# Comma-separated browser origins allowed to call the API (web dashboards). Empty = none.
CORS_ORIGINS=
